# ── Telegram Bot (satu-satunya variable "user-facing" — semua konfigurasi
# trading per-user diatur lewat command /config di bot, bukan di sini) ────────
TELEGRAM_BOT_TOKEN=

# ── Infrastruktur server (wajib diisi, bukan per-user) ────────────────────────
DATABASE_URL=postgresql://meridian:change_me@127.0.0.1:5432/meridian?schema=public
REDIS_URL=redis://127.0.0.1:6379
WALLET_MASTER_KEY_PATH=./secrets/wallet.master.key
NODE_ENV=production
LOG_LEVEL=info

# ── Jupiter Ultra referral (INCOME APLIKATOR — jangan diekspos ke user,
# selalu dari .env server, bukan dari /config per-user) ───────────────────────
JUPITER_API_KEY=
JUPITER_REFERRAL_ACCOUNT=
JUPITER_REFERRAL_FEE_BPS=50
